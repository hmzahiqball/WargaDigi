# Environment produksi untuk Docker (dipakai docker-compose.prod.yml)
# Nilai rahasia (APP_KEY, password DB) diisi otomatis oleh scripts/server-setup.sh
APP_NAME=WargaDigi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wargadigi21.com
ASSET_URL=/

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wargadigi
DB_USERNAME=wargadigi
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wargadigi21.com"
MAIL_FROM_NAME="${APP_NAME}"

# Port lokal yang di-listen container app (hanya di-bind ke 127.0.0.1).
# Caddy mem-proxy wargadigi21.com ke port ini.
APP_HOST_PORT=8080